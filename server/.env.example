# Nehdo Server Environment Configuration
PORT=8001
host=127.0.0.1
BACKEND_DOMIN_URL=https://nehdowellness.com
DB_URL=mongodb://127.0.0.1:27017/nehdowellness_db

# Security
JWT_SECRET=nehdo_secret_jwt_key_2026_secure
PASSWORD_JWT_SECRET=nehdo_password_secret_2026_secure

# Razorpay (Payment Gateway)
RAZORPAY_API_KEY=your_razorpay_key
RAZORPAY_API_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration (Nodemailer)
EMAIL_USER=support@nehdowellness.com
EMAIL_PASS=your_email_password_or_app_password

# Shiprocket (Logistics - if used)
SHIPROKET_EMAIL=your_shiprocket_email
SHIPROKET_PASSWORD=your_shiprocket_password
PICKUP_PINCODE=395006
