<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Nehdo - Reset Password</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0, 0, 0, .1);
        }

        .header {
            background: linear-gradient(135deg, #0f172a, #2563eb);
            padding: 35px 20px;
            text-align: center;
        }

        .header img {
            width: 180px;
            max-width: 100%;
            height: auto;
        }

        .header p {
            color: #dbeafe;
            margin-top: 12px;
            font-size: 15px;
        }

        .content {
            padding: 35px 30px;
        }

        .title {
            color: #111827;
            text-align: center;
            margin-bottom: 10px;
            font-size: 28px;
        }

        .subtitle {
            text-align: center;
            color: #6b7280;
            margin-bottom: 25px;
            line-height: 1.6;
            font-size: 15px;
        }

        .success-box {
            background: #dcfce7;
            border: 1px solid #16a34a;
            color: #166534;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            text-align: center;
        }

        .error-box {
            background: #fee2e2;
            border: 1px solid #ef4444;
            color: #991b1b;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            text-align: center;
        }

        .input-group {
            margin-bottom: 18px;
        }

        .input-group input {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            outline: none;
            font-size: 15px;
            transition: .3s;
        }

        .input-group input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
        }

        .btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: #2563eb;
            color: #fff;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: .3s;
        }

        .btn:hover {
            background: #1d4ed8;
        }

        .error-text {
            color: #dc2626;
            font-size: 14px;
            margin-bottom: 15px;
            display: none;
            text-align: center;
        }

        .footer {
            border-top: 1px solid #e5e7eb;
            background: #f8fafc;
            padding: 20px;
            text-align: center;
        }

        .footer h3 {
            color: #111827;
            margin-bottom: 6px;
        }

        .footer p {
            color: #6b7280;
            font-size: 13px;
            line-height: 1.6;
        }
    </style>

</head>

<body>

    <div class="container">

        <div class="header">

            <img src="/uploads/logo/nehdo-logo.png" alt="Nehdo Logo">

            <p>Secure Password Reset</p>

        </div>

        <div class="content">

            <!-- SUCCESS -->
            <% if (type==="success" ) { %>

                <div class="success-box">
                    <h2>🎉 Password Updated</h2>
                    <br>
                    <p><%= message %></p>
                    <br>
                    <p>Your <strong>Nehdo</strong> account password has been updated successfully.</p>
                </div>

                <!-- EXPIRED -->
                <% } else if (type==="expired" ) { %>

                    <div class="error-box">
                        <h2>⏰ Link Expired</h2>
                        <br>
                        <p><%= message %></p>
                        <br>
                        <p>Please request a new password reset link.</p>
                    </div>

                    <!-- INVALID -->
                    <% } else if (type==="error" ) { %>

                        <div class="error-box">
                            <h2>⚠️ Invalid Link</h2>
                            <br>
                            <p><%= message %></p>
                        </div>

                        <!-- FORM -->
                        <% } else { %>

                            <h2 class="title">
                                Reset Password
                            </h2>

                            <p class="subtitle">
                                Enter your new password for your
                                <strong>Nehdo</strong> account.
                            </p>

                            <div id="error" class="error-text">
                                Password and Confirm Password do not match.
                            </div>

                            <form id="resetForm"
                                action="/user/api/v1/auth/reset-password/<%= token %>"
                                method="POST">

                                <div class="input-group">
                                    <input type="password"
                                        id="password"
                                        name="password"
                                        placeholder="New Password"
                                        required />
                                </div>

                                <div class="input-group">
                                    <input type="password"
                                        id="confirmPassword"
                                        name="confirmPassword"
                                        placeholder="Confirm Password"
                                        required />
                                </div>

                                <button class="btn" type="submit">
                                    Reset Password
                                </button>

                            </form>

                            <% } %>

        </div>

        <div class="footer">

            <h3>Nehdo</h3>

            <p>
                Connecting Buyers & Sellers with Trust.
            </p>

            <br>

            <p>
                © <%= new Date().getFullYear() %> Nehdo. All Rights Reserved.
            </p>

        </div>

    </div>

    <script>

        const form = document.getElementById("resetForm");
        const password = document.getElementById("password");
        const confirmPassword = document.getElementById("confirmPassword");
        const error = document.getElementById("error");

        if (form) {

            form.addEventListener("submit", function (e) {

                if (password.value !== confirmPassword.value) {
                    e.preventDefault();
                    error.style.display = "block";
                } else {
                    error.style.display = "none";
                }

            });

        }

    </script>

</body>

</html>