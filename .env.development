# Loaded ONLY by `npm run dev` (Vite development mode) — never by `npm run build`.
# Committed on purpose so every developer sees the UI v2 redesign locally.
# Production keeps v1 until VITE_UI_V2=true is set in the live build environment.
# To look at the old UI locally, open http://localhost:5173/?ui=v1
VITE_UI_V2=true
